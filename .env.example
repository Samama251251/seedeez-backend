PORT=3001
NODE_ENV=development

# Supabase — Transaction pooler (port 6543)
DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Google OAuth — console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# In dev: http://localhost:3001/auth/google/callback
# In prod: https://your-railway-url.up.railway.app/auth/google/callback
OAUTH_REDIRECT_URI=http://localhost:3001/auth/google/callback

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=

# URL of the Next.js frontend (no trailing slash)
# In dev: http://localhost:3000
# In prod: https://seedeez.com
FRONTEND_URL=http://localhost:3000

# Groq — console.groq.com (used to suggest niche/competitors during onboarding)
GROQ_API_KEY=
