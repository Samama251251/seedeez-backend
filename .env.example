PORT=3001
NODE_ENV=development

# Supabase — Transaction pooler (port 6543)
DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Google OAuth — console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# In dev: http://localhost:3001/auth/google/callback
# In prod: https://your-railway-url.up.railway.app/auth/google/callback
OAUTH_REDIRECT_URI=http://localhost:3001/auth/google/callback

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=

# URL of the Next.js frontend (no trailing slash)
# In dev: http://localhost:3000
# In prod: https://seedeez.com
FRONTEND_URL=http://localhost:3000

# Groq — console.groq.com (used to suggest niche/competitors during onboarding)
GROQ_API_KEY=

# Cloudflare for SaaS (Custom Hostnames) — serves blog.theirs.com + per-host TLS
# API token needs "SSL and Certificates: Edit" on the zone below.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Fallback origin customers CNAME their blog subdomain to.
CLOUDFLARE_FALLBACK_ORIGIN=cname.seedeez.com

# Domain Connect — we act as the Service Provider that writes the customer's CNAME.
# providerId/serviceId must match the onboarded template (providerId.serviceId.json).
DOMAIN_CONNECT_PROVIDER_ID=seedeez.com
DOMAIN_CONNECT_SERVICE_ID=blog
# Domain holding our published public-key TXT (signs apply requests).
DOMAIN_CONNECT_SYNC_PUBKEY_DOMAIN=_dcpubkeyv1.seedeez.com
# PEM private key matching the published public key (single line, \n-escaped).
DOMAIN_CONNECT_PRIVATE_KEY=
# Where DNS hosts redirect back after the customer authorizes.
# In dev: http://localhost:3001/api/domains/domain-connect/callback
# In prod: https://api.seedeez.com/api/domains/domain-connect/callback
DOMAIN_CONNECT_REDIRECT_URI=http://localhost:3001/api/domains/domain-connect/callback
